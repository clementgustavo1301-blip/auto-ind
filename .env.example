# ==============================================================================
# VARIÁVEIS DE AMBIENTE - AUTO-IND (MODELO / TEMPLATE)
# ==============================================================================
# IMPORTANTE: Nunca coloque senhas ou chaves reais neste arquivo!
# 
# 1. No Desenvolvimento Local:
#    Copie este arquivo para .env.local e adicione sua chave real:
#    cp .env.example .env.local
#
# 2. Na Vercel (Produção):
#    Acesse: Projeto na Vercel > Settings > Environment Variables
#    e cadastre cada uma das variáveis abaixo com o seu valor real.
# ==============================================================================

# Chave da API SerpAPI (Obtenha em https://serpapi.com/users/sign_up - 250 buscas/mês grátis)
SERPAPI_KEY=sua_chave_serpapi_aqui

# Dia do mês em que a cota da SerpAPI renova (ex: 22)
SERPAPI_RENEWAL_DAY=22
